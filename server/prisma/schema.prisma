datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  assetsCreated DigitalAsset[] @relation("UserCreatedAssets")
  purchases     Purchase[]
}

model Category {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  assets    DigitalAsset[]
}

model DigitalAsset {
  id            String     @id @default(uuid())
  title         String
  description   String
  price         Float
  fileFormat    String
  fileSizeBytes Int
  filePath      String
  thumbnailUrl  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userId        String
  creator       User       @relation("UserCreatedAssets", fields: [userId], references: [id])

  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id])

  purchases     Purchase[]
}

model Purchase {
  id          String       @id @default(uuid())
  amountPaid  Float
  status      String       @default("COMPLETED")
  createdAt   DateTime     @default(now())

  userId      String
  user        User         @relation(fields: [userId], references: [id])

  assetId     String
  asset       DigitalAsset @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
}